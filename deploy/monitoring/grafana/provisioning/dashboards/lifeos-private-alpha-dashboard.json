{
  "title": "LifeOS Private Alpha Rollout",
  "uid": "lifeos-private-alpha",
  "description": "Invite-only private-alpha rollout health, readiness, and inquiry reliability signals",
  "tags": ["lifeos", "alpha", "inquiry", "rollout"],
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "title": "Active Users vs Cap",
      "type": "graph",
      "targets": [
        {"expr": "lifeos_private_alpha_active_users", "legendFormat": "active_users"},
        {"expr": "lifeos_private_alpha_user_cap", "legendFormat": "user_cap"}
      ]
    },
    {
      "id": 2,
      "title": "Cap Utilization",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:private_alpha_active_user_cap_utilization:ratio", "legendFormat": "utilization"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.85, "color": "yellow"},
            {"value": 1, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Invite Acceptance / Rejection Rates",
      "type": "graph",
      "targets": [
        {"expr": "lifeos:private_alpha_invite_acceptance_rate:ratio", "legendFormat": "acceptance_rate"},
        {"expr": "lifeos:private_alpha_invite_rejection_rate:ratio", "legendFormat": "rejection_rate"}
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 4,
      "title": "Readiness Completion / Blocked Rates",
      "type": "graph",
      "targets": [
        {"expr": "lifeos:private_alpha_readiness_completion_rate:ratio", "legendFormat": "ready_rate"},
        {"expr": "lifeos:private_alpha_readiness_blocked_rate:ratio", "legendFormat": "blocked_rate"}
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 5,
      "title": "Inquiry Failure Rate",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:private_alpha_inquiry_failure_rate:ratio", "legendFormat": "failure_rate"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.08, "color": "yellow"},
            {"value": 0.12, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Inquiry Latency p95",
      "type": "stat",
      "targets": [
        {"expr": "lifeos:private_alpha_inquiry_latency_p95:seconds", "legendFormat": "latency_p95"}
      ]
    },
    {
      "id": 7,
      "title": "Humanization Fallback Rate",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:private_alpha_humanization_fallback_rate:ratio", "legendFormat": "fallback_rate"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.15, "color": "yellow"},
            {"value": 0.25, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Technical Brief Expansion and Feedback Submission",
      "type": "graph",
      "targets": [
        {"expr": "lifeos:private_alpha_technical_brief_expansion_rate:ratio", "legendFormat": "technical_brief_expansion_rate"},
        {"expr": "lifeos:private_alpha_feedback_submission_rate:per_second", "legendFormat": "feedback_submissions_per_second"}
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s"
}
