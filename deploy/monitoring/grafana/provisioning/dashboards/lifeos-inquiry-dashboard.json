      "title": "Phase 8 Pair-Profile Low Coverage Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_low_coverage_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
