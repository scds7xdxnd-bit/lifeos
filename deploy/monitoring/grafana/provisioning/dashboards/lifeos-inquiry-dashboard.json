          "legendFormat": "{{ domain }} {{ state }} p{{ profile_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 25,
      "title": "Phase 8 Pair-Profile Blocked Claims Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_inquiry_blocked_claims_by_domain_total{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}[5m])) by (domain, profile_version, strategy_version)",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ]
    },
    {
