      "title": "Phase 8 Pair-Profile Latency p95 (seconds)",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_generation_latency_p95_by_domain_profile:seconds{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Duration", "format": "s"}]
    },
    {
      "id": 29,
      "title": "Phase 8 Pair-Profile Empty Brief Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_empty_brief_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
