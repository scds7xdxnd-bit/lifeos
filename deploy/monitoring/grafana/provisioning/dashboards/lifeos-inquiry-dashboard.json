      "title": "Phase 8 Pair-Profile Generated Rate (5m)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_inquiry_generated_by_domain_total{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}[5m])) by (domain, profile, profile_version, strategy_version)",
          "legendFormat": "{{ domain }} {{ profile }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ]
    },
    {
      "id": 27,
      "title": "Phase 8 Pair-Profile Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_error_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
