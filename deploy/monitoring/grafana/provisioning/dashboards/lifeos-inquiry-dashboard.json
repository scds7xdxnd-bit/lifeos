      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_refine_after_low_coverage_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 32,
      "title": "Phase 8 Pair-Profile Blocked Claims Total (5m increase)",
      "type": "graph",
      "targets": [
        {
          "expr": "increase(lifeos_inquiry_blocked_claims_by_domain_total{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}[5m])",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ]
    },
    {
      "id": 33,
      "title": "Phase 8 Pair-Profile Replay Mismatch Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_replay_mismatch_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 34,
      "title": "Phase 8 Pair-Profile Version Drift",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_inquiry_generated_by_domain_total{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\",profile_version!=\"1.0.0\"}[10m])) by (domain, profile_version)",
          "legendFormat": "{{ domain }} profile={{ profile_version }}"
        },
        {
          "expr": "sum(rate(lifeos_inquiry_generated_by_domain_total{expert_mode=\"true\",domain=~\"finance\\\\+habits|projects\\\\+skills|habits\\\\+journal|habits\\\\+health|calendar\\\\+projects|journal\\\\+relationships\",strategy_version!=\"1.0.0\"}[10m])) by (domain, strategy_version)",
