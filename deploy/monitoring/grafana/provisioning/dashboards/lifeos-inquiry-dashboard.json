      "title": "Phase 7.1 Later-Wave Domain Low Coverage Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_low_coverage_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"journal|relationships|health\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
