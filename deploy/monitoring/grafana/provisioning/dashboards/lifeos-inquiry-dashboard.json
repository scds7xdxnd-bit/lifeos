{
  "title": "LifeOS Focused Inquiry Ops (Phase 6/6.1/7/7.1/8)",
  "description": "Operational dashboard for focused inquiry rollout and domain/cross-domain expert quality signals",
  "tags": ["lifeos", "phase6", "phase61", "phase7", "phase71", "phase8", "inquiry"],
  "timezone": "utc",
  "panels": [
    {
      "id": 1,
      "title": "Inquiry Created / Generated / Viewed / Refined",
      "type": "graph",
      "targets": [
        {"expr": "increase(lifeos_inquiry_created_total[5m])", "legendFormat": "created"},
        {"expr": "increase(lifeos_inquiry_generated_total[5m])", "legendFormat": "generated"},
        {"expr": "increase(lifeos_inquiry_viewed_total[5m])", "legendFormat": "viewed"},
        {"expr": "increase(lifeos_inquiry_refined_total[5m])", "legendFormat": "refined"}
      ]
    },
    {
      "id": 2,
      "title": "Inquiry Generation Latency (p95)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lifeos_inquiry_generation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "yaxes": [{"label": "Duration", "format": "s"}]
    },
    {
      "id": 3,
      "title": "Inquiry Error Rate",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:inquiry_error_rate:ratio", "legendFormat": "error_ratio"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.05, "color": "yellow"},
            {"value": 0.1, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Empty Brief Rate",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:inquiry_empty_brief_rate:ratio", "legendFormat": "empty_ratio"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.4, "color": "yellow"},
            {"value": 0.6, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Evidence Coverage Ratio",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:inquiry_evidence_coverage_ratio", "legendFormat": "coverage"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "red"},
            {"value": 0.5, "color": "yellow"},
            {"value": 0.8, "color": "green"}
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Inquiry Endpoint Availability (5xx rate)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_http_request_latency_seconds_count{route=~\"/api/v1/inquiries.*\",status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 7,
      "title": "Migration Mismatch State",
      "type": "stat",
      "targets": [
        {"expr": "max(lifeos_phase6_inquiry_migration_mismatch)", "legendFormat": "mismatch"}
      ],
      "colorMode": "value"
    },
    {
      "id": 8,
      "title": "Low Coverage Rate",
      "type": "gauge",
      "targets": [
        {"expr": "lifeos:inquiry_low_coverage_rate:ratio", "legendFormat": "low_coverage_ratio"}
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.25, "color": "yellow"},
            {"value": 0.4, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Refine After Low Quality Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "lifeos:inquiry_refine_after_low_quality_rate:ratio",
          "legendFormat": "refine_after_low_quality_ratio"
        }
      ],
      "fieldConfig": {
        "min": 0,
        "max": 1,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.35, "color": "yellow"},
            {"value": 0.5, "color": "red"}
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Quality State Distribution",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_quality_state_distribution:ratio",
          "legendFormat": "{{ state }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 11,
      "title": "Phase 7 First-Wave Domain Expert Generated Rate (5m)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_inquiry_generated_by_domain_total{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}[5m])) by (domain, profile_version, strategy_version)",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Phase 7 First-Wave Domain Error Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_error_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 13,
      "title": "Phase 7 First-Wave Domain Latency p95 (seconds)",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_generation_latency_p95_by_domain_profile:seconds{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Duration", "format": "s"}]
    },
    {
      "id": 14,
      "title": "Phase 7 First-Wave Domain Empty Brief Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_empty_brief_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 15,
      "title": "Phase 7 First-Wave Domain Low Coverage Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_low_coverage_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 16,
      "title": "Phase 7 First-Wave Domain Refine After Low Quality Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_refine_after_low_quality_rate_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 17,
      "title": "Phase 7 First-Wave Domain Quality State Distribution",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_quality_state_distribution_by_domain_profile:ratio{expert_mode=\"true\",domain=~\"finance|habits|projects|skills\"}",
          "legendFormat": "{{ domain }} {{ state }} p{{ profile_version }}"
        }
      ],
      "yaxes": [{"label": "Ratio", "format": "percentunit"}]
    },
    {
      "id": 18,
      "title": "Phase 7.1 Later-Wave Domain Expert Generated Rate (5m)",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(lifeos_inquiry_generated_by_domain_total{expert_mode=\"true\",domain=~\"journal|relationships|health\"}[5m])) by (domain, profile_version, strategy_version)",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Phase 7.1 Later-Wave Domain Error Rate",
