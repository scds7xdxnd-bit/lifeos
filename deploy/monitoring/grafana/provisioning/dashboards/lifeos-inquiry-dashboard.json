    {
      "id": 20,
      "title": "Phase 7.1 Later-Wave Domain Latency p95 (seconds)",
      "type": "graph",
      "targets": [
        {
          "expr": "lifeos:inquiry_generation_latency_p95_by_domain_profile:seconds{expert_mode=\"true\",domain=~\"journal|relationships|health\"}",
          "legendFormat": "{{ domain }} p{{ profile_version }} s{{ strategy_version }}"
        }
